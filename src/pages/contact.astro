---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { contactChannels, faq, site } from '../data/site';
import { WHATSAPP_URL, WHATSAPP_CONFIGURED, FORMSPREE_ACTION, FORMSPREE_CONFIGURED } from '../lib/env';
---

<BaseLayout
  title="Contact"
  description="Contactez DevoriaTech pour votre projet de digitalisation. Premier échange gratuit et sans engagement. Réponse garantie sous 24h."
  path="/contact"
>
  <PageHero
    eyebrow="On vous répond sous 24h"
    title="Parlons de votre projet"
    sub="Premier échange gratuit et sans engagement. Remplissez le formulaire ou écrivez-nous directement sur WhatsApp."
  />

  <Section>
    <div class="contact">
      <!-- Coordonnées -->
      <div class="contact__info" data-reveal>
        {
          contactChannels.map((c) => (
            <div class="contact__card">
              <span class="contact__card-icon">
                <Icon name={c.icon} size={20} />
              </span>
              <div>
                <span class="contact__card-label">{c.label}</span>
                {c.href ? (
                  <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                    {c.value}
                  </a>
                ) : (
                  <span class="contact__card-value">{c.value}</span>
                )}
              </div>
            </div>
          ))
        }

        <div class="wa">
          <h2 class="wa__title">Préférez WhatsApp ?</h2>
          <p>En Afrique, c’est souvent plus rapide. On vous répond en quelques minutes.</p>
          <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="wa__btn">
            <Icon name="brand-whatsapp" size={19} /> Écrire sur WhatsApp
          </a>
          {!WHATSAPP_CONFIGURED && <span class="wa__todo">Numéro à configurer (PUBLIC_WHATSAPP_NUMBER)</span>}
        </div>
      </div>

      <!-- Formulaire -->
      <div class="form-wrap" data-reveal style="--reveal-delay:100ms">
        <h2>Envoyez-nous un message</h2>
        <p class="form-wrap__sub">
          Décrivez votre projet et nous vous recontactons sous 24h avec une proposition.
        </p>

        <form id="contactForm" action={FORMSPREE_ACTION || undefined} method="POST" data-configured={String(FORMSPREE_CONFIGURED)}>
          <div class="form-row">
            <div class="field">
              <label for="prenom">Prénom *</label>
              <input type="text" id="prenom" name="prenom" required placeholder="Votre prénom" />
            </div>
            <div class="field">
              <label for="nom">Nom *</label>
              <input type="text" id="nom" name="nom" required placeholder="Votre nom" />
            </div>
          </div>
          <div class="field">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required placeholder="nom@entreprise.com" />
          </div>
          <div class="form-row">
            <div class="field">
              <label for="pays">Pays *</label>
              <input type="text" id="pays" name="pays" required placeholder="Votre pays" />
            </div>
            <div class="field">
              <label for="service">Service souhaité *</label>
              <select id="service" name="service" required>
                <option value="">Choisir…</option>
                <option value="odoo">Implémentation Odoo</option>
                <option value="web">Site web</option>
                <option value="mobile">Application mobile</option>
                <option value="formation">Formation Odoo</option>
                <option value="ia">Automatisation / IA</option>
                <option value="autre">Autre / Je ne sais pas encore</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="budget">Ampleur du projet</label>
            <select id="budget" name="budget">
              <option value="">Sélectionner…</option>
              <option value="decouverte">Découverte / petit projet</option>
              <option value="standard">Projet standard</option>
              <option value="envergure">Projet d’envergure</option>
              <option value="adefinir">À définir ensemble</option>
            </select>
          </div>
          <div class="field">
            <label for="message">Décrivez votre projet *</label>
            <textarea id="message" name="message" required placeholder="Parlez-nous de votre entreprise, de vos besoins et de vos objectifs…"></textarea>
          </div>
          <button type="submit" class="btn btn-primary form-submit">
            Envoyer le message <Icon name="arrow-right" size={18} />
          </button>
          <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
          {
            !FORMSPREE_CONFIGURED && (
              <p class="form-todo">
                Envoi non configuré : à défaut de Formspree, votre logiciel mail s’ouvrira.
                Renseignez PUBLIC_FORMSPREE_ID dans <code>.env</code> pour l’envoi direct.
              </p>
            )
          }
        </form>
      </div>
    </div>
  </Section>

  <!-- FAQ -->
  <Section surface eyebrow="Questions fréquentes" title="Ce que nos clients demandent souvent" centered>
    <Faq items={faq} />
  </Section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }
  .contact__info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .contact__card {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.2rem;
    transition: border-color 0.2s var(--ease-smooth);
  }
  .contact__card:hover {
    border-color: var(--color-border-strong);
  }
  .contact__card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .contact__card-label {
    display: block;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-bottom: 0.2rem;
  }
  .contact__card a,
  .contact__card-value {
    font-size: 0.95rem;
    color: var(--color-text);
    word-break: break-word;
  }
  .contact__card a:hover {
    color: var(--color-accent);
  }

  .wa {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    text-align: center;
    margin-top: 0.5rem;
  }
  .wa__title {
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }
  .wa p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.2rem;
  }
  .wa__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #25d366;
    color: #04120a;
    font-weight: 500;
    font-size: 0.9rem;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-sm);
    min-height: 44px;
    transition: transform 0.2s var(--ease-smooth);
  }
  .wa__btn:hover {
    transform: translateY(-2px);
  }
  .wa__todo {
    display: block;
    margin-top: 0.7rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  /* Formulaire */
  .form-wrap {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .form-wrap h2 {
    font-size: 1.4rem;
    margin-bottom: 0.4rem;
  }
  .form-wrap__sub {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 1.8rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .field {
    margin-bottom: 1.1rem;
    display: flex;
    flex-direction: column;
  }
  .field label {
    font-size: 0.82rem;
    font-weight: 500;
    margin-bottom: 0.4rem;
    color: var(--color-text);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.92rem;
    transition: border-color 0.2s var(--ease-smooth);
    min-height: 44px;
  }
  .field textarea {
    resize: vertical;
    min-height: 130px;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-soft);
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--color-text-faint);
  }
  .form-submit {
    width: 100%;
    margin-top: 0.5rem;
  }
  .form-status {
    margin-top: 1rem;
    font-size: 0.9rem;
    text-align: center;
    display: none;
  }
  .form-status.is-ok {
    display: block;
    color: var(--color-accent);
  }
  .form-status.is-err {
    display: block;
    color: #e5644e;
  }
  .form-todo {
    margin-top: 1rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .form-todo code {
    font-family: var(--font-sans);
    background: var(--color-bg);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  @media (min-width: 560px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 900px) {
    .contact {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3rem;
    }
  }
</style>

<script is:inline define:vars={{ mailto: site.email }}>
  (function () {
    const form = document.getElementById('contactForm');
    if (!form) return;
    const status = document.getElementById('formStatus');
    const btn = form.querySelector('button[type=submit]');
    const configured = form.dataset.configured === 'true';

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const data = new FormData(form);

      if (!configured) {
        const lines = [];
        data.forEach((v, k) => lines.push(k + ' : ' + v));
        const body = encodeURIComponent(lines.join('\n'));
        const subject = encodeURIComponent('Demande de projet · DevoriaTech');
        window.location.href = 'mailto:' + mailto + '?subject=' + subject + '&body=' + body;
        return;
      }

      const original = btn.innerHTML;
      btn.disabled = true;
      btn.textContent = 'Envoi en cours…';
      fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      })
        .then((r) => {
          if (r.ok) {
            status.textContent = '✓ Message envoyé ! Nous vous répondrons sous 24h.';
            status.className = 'form-status is-ok';
            form.reset();
          } else {
            status.textContent = 'Erreur lors de l’envoi. Réessayez ou écrivez-nous par email.';
            status.className = 'form-status is-err';
          }
        })
        .catch(() => {
          status.textContent = 'Erreur réseau. Réessayez.';
          status.className = 'form-status is-err';
        })
        .finally(() => {
          btn.disabled = false;
          btn.innerHTML = original;
        });
    });
  })();
</script>
