---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import CtaSection from '../components/CtaSection.astro';
import Icon from '../components/Icon.astro';
import { values } from '../data/site';
import { ambitions, pillars } from '../data/catalog';

const founderTags = ['Odoo ERP', 'Python', 'IoT', 'IA', 'Dev Web'];
const associateProfiles = [
  'Développeur Full Stack',
  'Business Developer',
  'Expertise Odoo',
  'Réseau Afrique',
];
---

<BaseLayout
  title="À propos"
  description="DevoriaTech, fondée sur une conviction : la transformation digitale doit être accessible à toutes les entreprises africaines. Notre histoire, notre mission, notre équipe."
  path="/a-propos"
>
  <PageHero
    eyebrow="Notre histoire"
    title="À propos de DevoriaTech"
    sub="Une boîte fondée sur une conviction simple : la transformation digitale doit être accessible à toutes les entreprises africaines."
  />

  <!-- FONDATEUR -->
  <Section>
    <div class="founder">
      <div class="founder__text" data-reveal>
        <span class="eyebrow"><span class="dot"></span>Le fondateur</span>
        <h2 class="founder__title">Bâti par un développeur, pour des entrepreneurs</h2>
        <p>
          DevoriaTech est né de la rencontre entre une expertise technique solide et un
          constat terrain : les PME et startups d’Afrique francophone ont besoin de
          solutions digitales sérieuses, mais réellement adaptées à leur réalité.
        </p>
        <p>
          Après un Master en Management Digital et un projet de fin d’études centré sur
          Odoo avec intégrations IoT et IA, j’ai décidé de transformer cette expertise en
          solutions concrètes pour les entreprises d’Afrique francophone.
        </p>
      </div>

      <aside class="founder__card" data-reveal style="--reveal-delay:100ms">
        <span class="founder__card-glow" aria-hidden="true"></span>
        <span class="founder__avatar">MW</span>
        <span class="founder__name">Max-Wilfred GAK-NANBAYE</span>
        <span class="founder__role">Fondateur &amp; Expert Odoo · DevoriaTech</span>
        <p class="founder__bio">
          Expert en transformation digitale, spécialisé Odoo ERP/CRM. Master en Management
          Digital, au service des entreprises d’Afrique francophone.
        </p>
        <div class="founder__tags">
          {founderTags.map((t) => <span class="founder__tag">{t}</span>)}
        </div>
      </aside>
    </div>
  </Section>

  <!-- MISSION / VISION / VALEURS -->
  <Section surface eyebrow="Notre ADN" title="Mission, vision & valeurs" centered>
    <div class="mvp">
      {
        values.map((v, i) => (
          <article class="mvp__card" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span class="mvp__icon">
              <Icon name={v.icon} size={26} />
            </span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- AMBITION -->
  <Section
    eyebrow="Notre ambition"
    title="Voir grand pour l’Afrique"
    sub="Au-delà des projets, une vision : faire du numérique un levier de développement à l’échelle du continent."
    centered
  >
    <div class="ambitions">
      {
        ambitions.map((a, i) => (
          <article class="ambition" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <span class="ambition__icon"><Icon name={a.icon} size={24} /></span>
            <div>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- PILIERS -->
  <Section
    surface
    eyebrow="Notre approche"
    title="Bien plus que du développement"
    sub="Nous accompagnons chaque entreprise de la conception à la montée en compétences de ses équipes."
    centered
  >
    <div class="pillars-grid">
      {
        pillars.map((p, i) => (
          <article class="pillar-card" data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
            <span class="pillar-card__icon"><Icon name={p.icon} size={22} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ASSOCIÉ -->
  <Section eyebrow="On grandit ensemble" title="Nous recherchons un associé" centered>
    <div class="assoc" data-reveal>
      <span class="assoc__icon"><Icon name="handshake" size={30} /></span>
      <h3>Profil recherché : Tech + Business</h3>
      <p>
        DevoriaTech est en phase de lancement et cherche un associé complémentaire,
        idéalement avec un profil technique (dev, infra) ou commercial/business dev, pour
        co-construire la boîte et partager l’aventure.
      </p>
      <div class="assoc__profiles">
        {associateProfiles.map((p) => <span class="assoc__profile">{p}</span>)}
      </div>
      <a href="/contact" class="btn btn-primary">
        Candidater comme associé <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </Section>

  <CtaSection
    title="Construisons quelque chose de grand ensemble."
    sub="Que vous soyez client ou potentiel associé, parlons-en."
  />
</BaseLayout>

<style>
  /* Fondateur */
  .founder {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .founder__title {
    font-size: clamp(1.7rem, 3.5vw, 2.3rem);
    margin-block: 1rem;
    max-width: 18ch;
  }
  .founder__text p {
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: 1rem;
    max-width: 48ch;
  }
  .founder__card {
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(1.8rem, 4vw, 2.5rem);
    box-shadow: var(--shadow-md);
  }
  .founder__card-glow {
    position: absolute;
    inset: -40% -30% auto auto;
    width: 260px;
    aspect-ratio: 1;
    background: radial-gradient(circle, var(--glow-accent), transparent 65%);
    filter: blur(30px);
    pointer-events: none;
  }
  .founder__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2472c2, #0c447c);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }
  .founder__name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .founder__role {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    margin-bottom: 1.2rem;
  }
  .founder__bio {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 1.3rem;
  }
  .founder__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .founder__tag {
    font-size: 0.72rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  /* Ambitions */
  .ambitions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: 52rem;
    margin-inline: auto;
    text-align: left;
  }
  .ambition {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition:
      transform 0.25s var(--ease-smooth),
      border-color 0.25s var(--ease-smooth);
  }
  .ambition:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
  }
  .ambition__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .ambition h3 {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
  }
  .ambition p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Piliers */
  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .pillar-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    text-align: left;
  }
  .pillar-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    margin-bottom: 1rem;
  }
  .pillar-card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }
  .pillar-card p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* MVP */
  .mvp {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .mvp__card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    text-align: left;
  }
  .mvp__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    margin-bottom: 1.2rem;
  }
  .mvp__card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.6rem;
  }
  .mvp__card p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* Géo */
  .geo {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .geo__card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }
  .geo__flag {
    font-size: 1.8rem;
    display: block;
    margin-bottom: 0.7rem;
  }
  .geo__card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }
  .geo__card p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* Associé */
  .assoc {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
    background: var(--color-bg);
    border: 1.5px dashed var(--color-border-strong);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 5vw, 3rem);
  }
  .assoc__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    margin-bottom: 1rem;
  }
  .assoc h3 {
    font-size: 1.3rem;
    margin-bottom: 0.8rem;
  }
  .assoc p {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.75;
    margin-bottom: 1.5rem;
  }
  .assoc__profiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 1.8rem;
  }
  .assoc__profile {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  @media (min-width: 640px) {
    .mvp {
      grid-template-columns: repeat(3, 1fr);
    }
    .geo {
      grid-template-columns: repeat(2, 1fr);
    }
    .ambitions {
      grid-template-columns: repeat(2, 1fr);
    }
    .pillars-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .founder {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
    .pillars-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
</style>
