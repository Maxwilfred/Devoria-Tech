---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import CtaSection from '../components/CtaSection.astro';
import Icon from '../components/Icon.astro';
import { services, pricing, rates } from '../data/site';
---

<BaseLayout
  title="Services"
  description="Découvrez toutes les solutions digitales de DevoriaTech : Odoo ERP, sites web, apps mobiles, formation et automatisation IA. Tarifs clairs et transparents."
  path="/services"
>
  <PageHero
    eyebrow="Ce que nous proposons"
    title="Nos services digitaux"
    sub="Des solutions complètes pour digitaliser votre entreprise, de l’ERP au site web en passant par les applications mobiles."
  />

  <!-- BLOCS SERVICES -->
  <div class="svc">
    <div class="container-dt">
      {
        services.map((s, i) => (
          <article id={s.id} class="svc__block">
            <div class="svc__text" data-reveal>
              <span class="svc__icon">
                <Icon name={s.icon} size={26} />
              </span>
              <h2 class="svc__title">{s.title}</h2>
              <p class="svc__desc">{s.description}</p>
              <ul class="svc__list">
                {s.features.map((f) => (
                  <li>
                    <Icon name="check" size={17} />
                    {f}
                  </li>
                ))}
              </ul>
              <a href="/contact" class="btn btn-primary svc__cta">
                {s.cta} <Icon name="arrow-right" size={18} />
              </a>
            </div>
            <div class="svc__visual" data-reveal style="--reveal-delay:100ms">
              <div class="svc__panel">
                <span class="svc__panel-glow" aria-hidden="true" />
                <Icon name={s.icon} size={46} class="svc__panel-icon" />
                <span class="svc__panel-label">{s.title}</span>
                <span class="svc__panel-index">0{i + 1}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <!-- PACKAGES -->
  <Section
    surface
    eyebrow="Nos packages Odoo"
    title="Tarifs clairs et transparents"
    sub="Tous nos prix sont en EUR. Acompte de 50 % à la signature, solde à la livraison."
    centered
  >
    <div class="pricing">
      {
        pricing.map((p, i) => (
          <div
            class:list={['pricing__card', { 'is-featured': p.featured }]}
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
          >
            {p.featured && 'badge' in p && <span class="pricing__badge">{p.badge}</span>}
            <span class="pricing__name">{p.name}</span>
            <div class="pricing__price">
              {p.price}
              {p.unit && <span>{p.unit}</span>}
            </div>
            <p class="pricing__desc">{p.desc}</p>
            <ul class="pricing__features">
              {p.features.map((f) => (
                <li>
                  <Icon name="check" size={16} />
                  {f}
                </li>
              ))}
            </ul>
            <a
              href="/contact"
              class:list={['btn', p.featured ? 'btn-primary' : 'btn-ghost', 'pricing__cta']}
            >
              {p.cta}
            </a>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- TARIFS À LA CARTE -->
  <Section eyebrow="Autres services" title="Tarifs à la carte">
    <div class="rates" data-reveal>
      <div class="rates__head">
        <span>Service</span>
        <span>Fourchette de prix</span>
        <span>Délai moyen</span>
      </div>
      {
        rates.map((r) => (
          <div class="rates__row">
            <span class="rates__svc">{r.service}</span>
            <span class="rates__price">{r.price}</span>
            <span class="rates__delay">{r.delay}</span>
          </div>
        ))
      }
    </div>
  </Section>

  <CtaSection eyebrow="Prêt à démarrer ?" sub="Premier échange gratuit et sans engagement. Réponse sous 24h." />
</BaseLayout>

<style>
  /* ── Blocs services ── */
  .svc__block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--color-border);
  }
  .svc__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    margin-bottom: 1.2rem;
  }
  .svc__title {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    margin-bottom: 1rem;
  }
  .svc__desc {
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: 1.5rem;
    max-width: 42ch;
  }
  .svc__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-bottom: 2rem;
  }
  .svc__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.92rem;
    color: var(--color-text);
  }
  .svc__list :global(svg) {
    color: var(--color-accent);
    margin-top: 2px;
    flex-shrink: 0;
  }
  .svc__panel {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1rem;
    min-height: 260px;
    padding: 2rem;
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }
  .svc__panel-glow {
    position: absolute;
    inset: -40% -20% auto auto;
    width: 300px;
    aspect-ratio: 1;
    background: radial-gradient(circle, var(--glow-accent), transparent 65%);
    filter: blur(30px);
    pointer-events: none;
  }
  .svc__panel-icon {
    color: var(--color-accent);
  }
  .svc__panel-label {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    max-width: 16ch;
  }
  .svc__panel-index {
    position: absolute;
    right: 1.6rem;
    bottom: 1.2rem;
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--color-border-strong);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  @media (min-width: 900px) {
    .svc__block {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
    }
    .svc__block:nth-child(even) .svc__text {
      order: 2;
    }
  }

  /* ── Pricing ── */
  .pricing {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 68rem;
    margin-inline: auto;
  }
  .pricing__card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }
  .pricing__card.is-featured {
    border: 2px solid var(--color-accent);
    box-shadow: var(--shadow-glow);
  }
  .pricing__badge {
    position: absolute;
    top: -0.75rem;
    left: 2rem;
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .pricing__name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.6rem;
  }
  .pricing__price {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-accent);
    margin-bottom: 0.4rem;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .pricing__price span {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .pricing__desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .pricing__features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
    margin-bottom: 2rem;
  }
  .pricing__features li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.88rem;
    color: var(--color-text);
  }
  .pricing__features :global(svg) {
    color: var(--color-accent);
    margin-top: 2px;
    flex-shrink: 0;
  }
  .pricing__cta {
    width: 100%;
  }

  @media (min-width: 820px) {
    .pricing {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
    .pricing__card.is-featured {
      transform: scale(1.03);
    }
  }

  /* ── Tarifs à la carte ── */
  .rates {
    max-width: 60rem;
    margin-inline: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .rates__head,
  .rates__row {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 1rem;
    padding: 1rem 1.3rem;
    align-items: center;
  }
  .rates__head {
    background: var(--color-surface-2);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .rates__row {
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
    transition: background 0.2s var(--ease-smooth);
  }
  .rates__row:hover {
    background: var(--color-surface);
  }
  .rates__price {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--color-accent);
  }
  .rates__delay {
    color: var(--color-text-muted);
  }
  @media (max-width: 600px) {
    .rates__head {
      display: none;
    }
    .rates__row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
      padding: 1.1rem 1.2rem;
    }
    .rates__svc {
      font-weight: 500;
    }
  }
</style>
