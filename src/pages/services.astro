---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import CtaSection from '../components/CtaSection.astro';
import Icon from '../components/Icon.astro';
import { serviceFamilies, approche360 } from '../data/catalog';
import { pricing, rates } from '../data/site';

/* Icône par service (par mots-clés, robuste aux apostrophes typographiques) */
function svcIcon(title: string, fallback: string): string {
  const t = title.toLowerCase();
  if (t.includes('crm')) return 'users';
  if (t.startsWith('mes')) return 'chart-dots';
  if (t.startsWith('erp')) return 'database';
  if (t.includes('site web')) return 'world-www';
  if (t.includes('mobile')) return 'device-mobile';
  if (t.includes('application web')) return 'browser';
  if (t.includes('bureautique')) return 'device-desktop';
  if (t.includes('intelligence')) return 'sparkles';
  if (t.includes('iot')) return 'plug-connected';
  if (t.includes('agriculture')) return 'leaf';
  if (t.includes('digitalisation')) return 'refresh';
  if (t.includes('rpa')) return 'robot';
  if (t.includes('automatisation industrielle')) return 'settings';
  if (t.includes('applications industrielles')) return 'building-factory';
  if (t.includes('infrastructure')) return 'server';
  return fallback;
}
---

<BaseLayout
  title="Services"
  description="Le catalogue complet DevoriaTech : systèmes d’information (CRM, MES, ERP), développement web et mobile, IA, IoT/IIoT, automatisation industrielle, smart agriculture et infrastructure IT."
  path="/services"
>
  <PageHero
    eyebrow="Ce que nous proposons"
    title="La transformation numérique, de bout en bout"
    sub="Des systèmes d’information à l’automatisation industrielle : nous couvrons tout le cycle de vie du numérique dans votre entreprise. Notre cœur de métier reste la digitalisation des entreprises."
  />

  <!-- APPROCHE 360° + navigation par famille -->
  <Section
    eyebrow="Notre approche 360°"
    title="Une vision complète du numérique"
    sub="Cinq familles qui couvrent la stratégie, les interfaces, l’intelligence, la transformation et le cœur physique de votre entreprise."
    centered
  >
    <div class="pillars">
      {
        approche360.map((p, i) => (
          <a href={`#${serviceFamilies[i].id}`} class="pillar" data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <span class="pillar__icon"><Icon name={p.icon} size={22} /></span>
            <span class="pillar__title">{p.title}</span>
            <span class="pillar__text">{p.text}</span>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- FAMILLES DE SERVICES -->
  {
    serviceFamilies.map((fam, fi) => (
      <section id={fam.id} class:list={['fam', { 'fam--surface': fi % 2 === 1 }]}>
        <div class="container-dt">
          <header class="fam__head" data-reveal>
            <span class="fam__icon"><Icon name={fam.icon} size={26} /></span>
            <div>
              <span class="fam__eyebrow">Famille {String(fi + 1).padStart(2, '0')}</span>
              <h2 class="fam__name">{fam.name}</h2>
              <p class="fam__tagline">{fam.tagline}</p>
            </div>
          </header>

          <div class="cat-grid">
            {fam.services.map((svc, si) => (
              <article class="cat-card" data-reveal style={`--reveal-delay:${(si % 2) * 70}ms`}>
                <span class="cat-card__icon">
                  <Icon name={svcIcon(svc.title, fam.icon)} size={22} />
                </span>
                <h3 class="cat-card__title">{svc.title}</h3>
                {svc.tagline && <p class="cat-card__tagline">{svc.tagline}</p>}
                <p class="cat-card__desc">{svc.description}</p>
                {svc.sub && (
                  <ul class="cat-card__sub">
                    {svc.sub.map((s) => (
                      <li>
                        <strong>{s.label}</strong> : {s.text}
                      </li>
                    ))}
                  </ul>
                )}
                <div class="cat-card__delivers">
                  <span class="cat-card__delivers-label">
                    <Icon name="package" size={15} /> Ce que nous livrons
                  </span>
                  <p>{svc.delivers}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <!-- PACKAGES ODOO -->
  <Section
    surface
    eyebrow="Nos packages Odoo"
    title="Tarifs clairs et transparents"
    sub="Pour démarrer votre digitalisation avec Odoo. Tous nos prix sont en EUR. Acompte de 50 % à la signature, solde à la livraison."
    centered
  >
    <div class="pricing">
      {
        pricing.map((p, i) => (
          <div
            class:list={['pricing__card', { 'is-featured': p.featured }]}
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
          >
            {p.featured && 'badge' in p && <span class="pricing__badge">{p.badge}</span>}
            <span class="pricing__name">{p.name}</span>
            <div class="pricing__price">
              {p.price}
              {p.unit && <span>{p.unit}</span>}
            </div>
            <p class="pricing__desc">{p.desc}</p>
            <ul class="pricing__features">
              {p.features.map((f) => (
                <li>
                  <Icon name="check" size={16} />
                  {f}
                </li>
              ))}
            </ul>
            <a
              href="/contact"
              class:list={['btn', p.featured ? 'btn-primary' : 'btn-ghost', 'pricing__cta']}
            >
              {p.cta}
            </a>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- TARIFS À LA CARTE -->
  <Section eyebrow="Autres services" title="Tarifs à la carte">
    <div class="rates" data-reveal>
      <div class="rates__head">
        <span>Service</span>
        <span>Fourchette de prix</span>
        <span>Délai moyen</span>
      </div>
      {
        rates.map((r) => (
          <div class="rates__row">
            <span class="rates__svc">{r.service}</span>
            <span class="rates__price">{r.price}</span>
            <span class="rates__delay">{r.delay}</span>
          </div>
        ))
      }
    </div>
  </Section>

  <CtaSection eyebrow="Prêt à démarrer ?" sub="Premier échange gratuit et sans engagement. Réponse sous 24h." />
</BaseLayout>

<style>
  /* ── Approche 360° ── */
  .pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
  }
  .pillar {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition:
      transform 0.25s var(--ease-smooth),
      border-color 0.25s var(--ease-smooth);
  }
  .pillar:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
  }
  .pillar__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    margin-bottom: 0.3rem;
  }
  .pillar__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
  }
  .pillar__text {
    font-size: 0.84rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* ── Familles ── */
  .fam {
    padding-block: clamp(3rem, 7vw, 5rem);
    scroll-margin-top: 80px;
  }
  .fam--surface {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }
  .fam__head {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    margin-bottom: 2.2rem;
  }
  .fam__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-lg);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .fam__eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    font-weight: 500;
  }
  .fam__name {
    font-size: clamp(1.5rem, 3.5vw, 2.1rem);
    margin-block: 0.2rem 0.2rem;
  }
  .fam__tagline {
    color: var(--color-text-muted);
    font-style: italic;
    font-size: 0.95rem;
  }

  .cat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
    align-items: start;
  }
  .cat-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    height: 100%;
    transition:
      transform 0.25s var(--ease-smooth),
      border-color 0.25s var(--ease-smooth),
      box-shadow 0.25s var(--ease-smooth);
  }
  .fam--surface .cat-card {
    background: var(--color-bg);
  }
  .cat-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }
  .cat-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border: 1px solid var(--color-border);
  }
  .cat-card__title {
    font-size: 1.12rem;
    letter-spacing: -0.02em;
  }
  .cat-card__tagline {
    font-style: italic;
    font-size: 0.85rem;
    color: var(--color-accent);
    margin-top: -0.3rem;
  }
  .cat-card__desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }
  .cat-card__sub {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-block: 0.2rem;
  }
  .cat-card__sub li {
    font-size: 0.86rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    padding-left: 0.9rem;
    border-left: 2px solid var(--color-border-strong);
  }
  .cat-card__sub strong {
    color: var(--color-text);
    font-weight: 500;
  }
  .cat-card__delivers {
    margin-top: auto;
    padding: 0.9rem 1rem;
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-border);
  }
  .cat-card__delivers-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }
  .cat-card__delivers p {
    font-size: 0.85rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  @media (min-width: 720px) {
    .pillars {
      grid-template-columns: repeat(5, 1fr);
    }
    .cat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Pricing (repris) ── */
  .pricing {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 68rem;
    margin-inline: auto;
  }
  .pricing__card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }
  .pricing__card.is-featured {
    border: 2px solid var(--color-accent);
    box-shadow: var(--shadow-glow);
  }
  .pricing__badge {
    position: absolute;
    top: -0.75rem;
    left: 2rem;
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .pricing__name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.6rem;
  }
  .pricing__price {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-accent);
    margin-bottom: 0.4rem;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .pricing__price span {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .pricing__desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .pricing__features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
    margin-bottom: 2rem;
  }
  .pricing__features li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.88rem;
    color: var(--color-text);
  }
  .pricing__features :global(svg) {
    color: var(--color-accent);
    margin-top: 2px;
    flex-shrink: 0;
  }
  .pricing__cta {
    width: 100%;
  }

  @media (min-width: 820px) {
    .pricing {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
    .pricing__card.is-featured {
      transform: scale(1.03);
    }
  }

  /* ── Tarifs à la carte (repris) ── */
  .rates {
    max-width: 60rem;
    margin-inline: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .rates__head,
  .rates__row {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 1rem;
    padding: 1rem 1.3rem;
    align-items: center;
  }
  .rates__head {
    background: var(--color-surface-2);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .rates__row {
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
    transition: background 0.2s var(--ease-smooth);
  }
  .rates__row:hover {
    background: var(--color-surface);
  }
  .rates__price {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--color-accent);
  }
  .rates__delay {
    color: var(--color-text-muted);
  }
  @media (max-width: 600px) {
    .rates__head {
      display: none;
    }
    .rates__row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
      padding: 1.1rem 1.2rem;
    }
    .rates__svc {
      font-weight: 500;
    }
  }
</style>
