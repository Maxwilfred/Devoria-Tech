---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import StatBar from '../components/StatBar.astro';
import Section from '../components/Section.astro';
import ServiceBento from '../components/ServiceBento.astro';
import CtaSection from '../components/CtaSection.astro';
import Icon from '../components/Icon.astro';
import { heroStats, whyPoints, processSteps, geoPills } from '../data/site';
---

<BaseLayout
  title="DevoriaTech · Bâtir le digital qui dure"
  description="DevoriaTech accompagne les PME et startups d’Afrique dans leur transformation digitale : ERP Odoo, sites web, applications mobiles et automatisation IA. Réponse sous 24h."
  path="/"
>
  <Hero />
  <Marquee />
  <StatBar stats={heroStats} />

  <!-- SERVICES -->
  <Section
    eyebrow="Ce que nous faisons"
    title="Un partenaire digital 360°"
    sub="Des systèmes d’information à l’automatisation industrielle, nous couvrons tout le cycle de vie du numérique. La digitalisation des entreprises reste notre cœur de métier."
  >
    <ServiceBento />
  </Section>

  <!-- POURQUOI NOUS -->
  <Section surface>
    <div class="why">
      <div class="why__text">
        <span class="eyebrow" data-reveal><span class="dot"></span>Pourquoi nous choisir</span>
        <h2 class="why__title" data-reveal style="--reveal-delay:60ms">
          L’expertise technique au service de votre croissance
        </h2>
        <div class="why__points">
          {
            whyPoints.map((p, i) => (
              <div class="why__point" data-reveal style={`--reveal-delay:${i * 80}ms`}>
                <span class="why__num">{p.num}</span>
                <div>
                  <h3 class="why__point-title">{p.title}</h3>
                  <p class="why__point-text">{p.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <aside class="why__card" data-reveal style="--reveal-delay:120ms">
        <div class="why__quote-glow" aria-hidden="true"></div>
        <Icon name="quote" size={30} class="why__quote-icon" />
        <p class="why__quote">
          La digitalisation n’est pas un luxe réservé aux grandes entreprises.
        </p>
        <div class="why__geo">
          {
            geoPills.map((g) => (
              <span class="why__pill">
                <span class="why__dot" style={`background:${g.color}`} />
                {g.label}
              </span>
            ))
          }
        </div>
      </aside>
    </div>
  </Section>

  <!-- PROCESSUS -->
  <Section
    eyebrow="Notre méthode"
    title="Un projet, 4 étapes"
    centered
  >
    <ol class="proc">
      {
        processSteps.map((s, i) => (
          <li class="proc__step" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span class="proc__num">{s.num}</span>
            <h3 class="proc__title">{s.title}</h3>
            <p class="proc__text">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <CtaSection />
</BaseLayout>

<style>
  /* ── Pourquoi nous ── */
  .why {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .why__title {
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    margin-block: 1rem 2rem;
    max-width: 20ch;
  }
  .why__points {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
  .why__point {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
  }
  .why__num {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: -0.04em;
    line-height: 1;
    flex-shrink: 0;
    width: 2.2rem;
  }
  .why__point-title {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
  }
  .why__point-text {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }
  .why__card {
    position: relative;
    overflow: hidden;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(1.8rem, 4vw, 2.6rem);
    box-shadow: var(--shadow-md);
  }
  .why__quote-glow {
    position: absolute;
    inset: auto -30% -50% auto;
    width: 260px;
    aspect-ratio: 1;
    background: radial-gradient(circle, var(--glow-accent), transparent 65%);
    filter: blur(30px);
    pointer-events: none;
  }
  .why__quote-icon {
    color: var(--color-accent);
    margin-bottom: 1rem;
  }
  .why__quote {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.35;
    margin-bottom: 1.8rem;
  }
  .why__geo {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    position: relative;
  }
  .why__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
  }
  .why__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  /* ── Processus ── */
  .proc {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    list-style: none;
    counter-reset: proc;
  }
  .proc__step {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.8rem 1.5rem;
    text-align: center;
    transition:
      transform 0.25s var(--ease-smooth),
      border-color 0.25s var(--ease-smooth);
  }
  .proc__step:hover {
    transform: translateY(-3px);
    border-color: var(--color-border-strong);
  }
  .proc__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }
  .proc__title {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }
  .proc__text {
    font-size: 0.86rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (min-width: 720px) {
    .proc {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 900px) {
    .why {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
  }
</style>
