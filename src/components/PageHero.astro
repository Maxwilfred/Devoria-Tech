---
interface Props {
  eyebrow: string;
  title: string;
  sub?: string;
}
const { eyebrow, title, sub } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero__bg" aria-hidden="true"></div>
  <div class="container-dt page-hero__inner">
    <span class="eyebrow page-hero__eyebrow"><span class="dot"></span>{eyebrow}</span>
    <h1 class="page-hero__title">{title}</h1>
    {sub && <p class="page-hero__sub">{sub}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 8vw, 5rem) clamp(2.5rem, 6vw, 4rem);
    border-bottom: 1px solid var(--color-border);
  }
  .page-hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(50% 60% at 85% 0%, var(--glow-accent) 0%, transparent 60%),
      radial-gradient(40% 50% at 5% 10%, rgba(24, 95, 165, 0.12) 0%, transparent 60%);
    pointer-events: none;
  }
  .page-hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    max-width: 46rem;
  }
  .page-hero__eyebrow {
    opacity: 0;
    animation: fade-up 0.6s var(--ease-smooth) 0.05s forwards;
  }
  .page-hero__title {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    letter-spacing: -0.04em;
    line-height: 1.03;
    opacity: 0;
    animation: fade-up 0.6s var(--ease-smooth) 0.13s forwards;
  }
  .page-hero__sub {
    color: var(--color-text-muted);
    font-size: clamp(1.02rem, 2.2vw, 1.2rem);
    line-height: 1.7;
    max-width: 40rem;
    opacity: 0;
    animation: fade-up 0.6s var(--ease-smooth) 0.22s forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .page-hero__eyebrow,
    .page-hero__title,
    .page-hero__sub {
      opacity: 1;
      animation: none;
    }
  }
</style>
