---
/* Fenêtre terminal stylisée — CSS pur. Les lignes apparaissent en séquence
   au chargement (animation one-shot, transform/opacity uniquement). */
interface Props {
  title?: string;
  class?: string;
}
const { title = 'devoria — deploy', class: className } = Astro.props;

const lines = [
  { p: '$', cmd: 'devoria init', c: 'accent' },
  { p: '', cmd: '✔ Analyse des besoins métier', c: 'ok' },
  { p: '', cmd: '✔ Odoo Community 17 · CRM · Ventes · Stock', c: 'ok' },
  { p: '$', cmd: 'devoria deploy --with iot,ia', c: 'accent' },
  { p: '', cmd: 'Configuration des modules…', c: 'muted' },
  { p: '', cmd: '✔ IoT connecté · IA activée', c: 'ok' },
  { p: '', cmd: '➜ Mise en production réussie 🚀', c: 'hl' },
];
---

<div class:list={['dt-term', className]} role="img" aria-label="Terminal montrant un déploiement Odoo par DevoriaTech">
  <div class="dt-term__bar">
    <span class="dt-term__dots" aria-hidden="true">
      <i></i><i></i><i></i>
    </span>
    <span class="dt-term__title">{title}</span>
  </div>
  <div class="dt-term__body">
    {
      lines.map((l, i) => (
        <div class="dt-term__line" style={`--i:${i}`}>
          {l.p && <span class="dt-term__prompt">{l.p}</span>}
          <span class:list={['dt-term__txt', `is-${l.c}`]}>{l.cmd}</span>
        </div>
      ))
    }
    <span class="dt-term__cursor" aria-hidden="true"></span>
  </div>
</div>

<style>
  .dt-term {
    background: color-mix(in srgb, var(--color-surface-2) 88%, #000);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    font-family: var(--font-sans);
    width: 100%;
    backdrop-filter: blur(6px);
  }
  :global([data-theme='light']) .dt-term {
    background: #0e1420;
    border-color: rgba(255, 255, 255, 0.1);
  }
  .dt-term__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
  }
  .dt-term__dots {
    display: inline-flex;
    gap: 6px;
  }
  .dt-term__dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #46464d;
  }
  .dt-term__dots i:nth-child(1) {
    background: #ff5f57;
  }
  .dt-term__dots i:nth-child(2) {
    background: #febc2e;
  }
  .dt-term__dots i:nth-child(3) {
    background: #28c840;
  }
  .dt-term__title {
    font-size: 0.78rem;
    color: rgba(245, 245, 243, 0.5);
    letter-spacing: 0.02em;
  }
  .dt-term__body {
    padding: 1.1rem 1.2rem 1.4rem;
    font-size: 0.86rem;
    line-height: 1.9;
    min-height: 268px;
    color: #cfd3cf;
  }
  .dt-term__line {
    display: flex;
    gap: 0.6rem;
    opacity: 0;
    transform: translateY(6px);
    animation: term-in 0.4s var(--ease-smooth) forwards;
    animation-delay: calc(0.35s + var(--i) * 0.28s);
    white-space: nowrap;
  }
  @keyframes term-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .dt-term__prompt {
    color: var(--color-mint);
    font-weight: 500;
  }
  .dt-term__txt {
    font-variant-ligatures: none;
  }
  .is-accent {
    color: #eef1ee;
  }
  .is-ok {
    color: #7fe6b3;
  }
  .is-muted {
    color: rgba(245, 245, 243, 0.62);
  }
  .is-hl {
    color: var(--color-mint);
    font-weight: 500;
  }
  .dt-term__cursor {
    display: inline-block;
    width: 9px;
    height: 17px;
    background: var(--color-mint);
    vertical-align: middle;
    opacity: 0;
    animation:
      term-cursor-show 0.1s linear 2.4s forwards,
      term-blink 1.1s step-end 2.4s infinite;
  }
  @keyframes term-cursor-show {
    to {
      opacity: 1;
    }
  }
  @keyframes term-blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dt-term__line {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .dt-term__cursor {
      animation: none;
      opacity: 1;
    }
  }
</style>
