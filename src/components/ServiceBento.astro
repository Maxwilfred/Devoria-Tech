---
import Icon from './Icon.astro';
import SpotlightCard from './react/SpotlightCard.tsx';
import { serviceFamilies } from '../data/catalog';

/* Répartition asymétrique (type linear.app) sur 12 colonnes desktop.
   Systèmes d'information = carte vedette large. */
const spans = ['bento--feature', 'bento--md', 'bento--md', 'bento--sm', 'bento--sm'];
---

<div class="bento">
  {
    serviceFamilies.map((fam, i) => (
      <SpotlightCard
        client:media="(hover: hover) and (pointer: fine)"
        className={`bento__cell ${spans[i]}`}
      >
        <a href={`/services#${fam.id}`} class="bento__card" data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <span class="bento__icon">
            <Icon name={fam.icon} size={22} />
          </span>
          <div class="bento__text">
            <h3 class="bento__title">{fam.name}</h3>
            <p class="bento__desc">{fam.blurb}</p>
          </div>
          {i === 0 && (
            <div class="bento__chips" aria-hidden="true">
              {serviceFamilies.flatMap((f) => f.tags).slice(0, 8).map((c) => (
                <span class="bento__chip">{c}</span>
              ))}
            </div>
          )}
          <span class="bento__more">
            En savoir plus <Icon name="arrow-right" size={16} />
          </span>
        </a>
      </SpotlightCard>
    ))
  }
</div>

<style>
  .bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .bento :global(.bento__cell) {
    min-height: 100%;
  }
  .bento__card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 1.6rem;
    color: inherit;
  }
  .bento__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    flex-shrink: 0;
  }
  .bento__text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }
  .bento__title {
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .bento__desc {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }
  .bento__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .bento__chip {
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }
  .bento__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-accent);
    margin-top: auto;
    transition: gap 0.2s var(--ease-smooth);
  }
  .bento__card:hover .bento__more {
    gap: 0.7rem;
  }

  @media (min-width: 640px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .bento :global(.bento--feature) {
      grid-column: span 2;
    }
  }
  @media (min-width: 960px) {
    .bento {
      grid-template-columns: repeat(12, 1fr);
      grid-auto-rows: 1fr;
    }
    .bento :global(.bento--feature) {
      grid-column: span 6;
      grid-row: span 2;
    }
    .bento :global(.bento--md) {
      grid-column: span 6;
    }
    .bento :global(.bento--sm) {
      grid-column: span 6;
    }
    .bento :global(.bento--feature) .bento__title {
      font-size: 1.5rem;
    }
  }
</style>
