---
import Icon from './Icon.astro';

/* Maquette de tableau de bord (style Odoo) — CSS pur, theme-aware.
   Concrète et parlante pour des dirigeants de PME : commandes, ventes,
   clients, stock. Les barres montent en séquence au chargement (transform
   uniquement → 60 fps), désactivé si prefers-reduced-motion. */

const bars = [42, 55, 48, 68, 60, 82]; // hauteurs relatives (%) sur 6 mois
const months = ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin'];
---

<div class="dash" role="img" aria-label="Aperçu d'un tableau de bord Odoo : commandes, ventes mensuelles, clients actifs et niveau de stock">
  <div class="dash__bar">
    <span class="dash__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="dash__titlebar">Tableau de bord — Odoo</span>
    <span class="dash__live" aria-hidden="true"><span></span>En direct</span>
  </div>

  <div class="dash__body">
    <!-- KPI principal -->
    <div class="dash__kpi">
      <div>
        <span class="dash__kpi-label">Commandes ce mois</span>
        <span class="dash__kpi-value">342</span>
      </div>
      <span class="dash__trend">
        <Icon name="arrow-up-right" size={14} /> +18 %
      </span>
    </div>

    <!-- Graphique de ventes -->
    <div class="dash__chart-head">
      <span>Ventes · 6 derniers mois</span>
      <span class="dash__chart-tag">Croissance</span>
    </div>
    <div class="dash__chart" aria-hidden="true">
      {
        bars.map((h, i) => (
          <div class="dash__col">
            <div
              class="dash__bar-fill"
              class:list={[{ 'is-peak': i === bars.length - 1 }]}
              style={`--h:${h}%; --d:${0.15 + i * 0.09}s`}
            />
            <span class="dash__month">{months[i]}</span>
          </div>
        ))
      }
    </div>

    <!-- Tuiles secondaires -->
    <div class="dash__tiles">
      <div class="dash__tile">
        <span class="dash__tile-icon"><Icon name="users" size={16} /></span>
        <div>
          <span class="dash__tile-value">1 280</span>
          <span class="dash__tile-label">Clients actifs</span>
        </div>
      </div>
      <div class="dash__tile">
        <span class="dash__tile-icon dash__tile-icon--ok"><Icon name="package" size={16} /></span>
        <div>
          <span class="dash__tile-value">94 %</span>
          <span class="dash__tile-label">Stock disponible</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .dash {
    width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    font-family: var(--font-sans);
  }
  .dash__bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-2);
  }
  .dash__dots {
    display: inline-flex;
    gap: 6px;
  }
  .dash__dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border-strong);
  }
  .dash__dots i:nth-child(1) {
    background: #ff5f57;
  }
  .dash__dots i:nth-child(2) {
    background: #febc2e;
  }
  .dash__dots i:nth-child(3) {
    background: #28c840;
  }
  .dash__titlebar {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .dash__live {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }
  .dash__live span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-mint);
    box-shadow: 0 0 8px var(--color-mint);
    animation: dash-pulse 1.8s var(--ease-smooth) infinite;
  }
  @keyframes dash-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .dash__body {
    padding: 1.2rem 1.3rem 1.4rem;
  }

  /* KPI */
  .dash__kpi {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.4rem;
  }
  .dash__kpi-label {
    display: block;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-bottom: 0.3rem;
  }
  .dash__kpi-value {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-text);
  }
  .dash__trend {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  /* Chart */
  .dash__chart-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 0.7rem;
  }
  .dash__chart-tag {
    font-size: 0.68rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-faint);
  }
  .dash__chart {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    height: 96px;
    margin-bottom: 1.3rem;
  }
  .dash__col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    height: 100%;
    justify-content: flex-end;
  }
  .dash__bar-fill {
    width: 100%;
    max-width: 26px;
    height: var(--h);
    border-radius: 5px 5px 3px 3px;
    background: color-mix(in srgb, var(--color-accent) 32%, transparent);
    transform: scaleY(0);
    transform-origin: bottom;
    animation: dash-bar 0.7s var(--ease-smooth) var(--d) forwards;
  }
  .dash__bar-fill.is-peak {
    background: var(--color-accent);
    box-shadow: 0 0 16px var(--glow-accent);
  }
  @keyframes dash-bar {
    to {
      transform: scaleY(1);
    }
  }
  .dash__month {
    font-size: 0.62rem;
    color: var(--color-text-faint);
  }

  /* Tuiles */
  .dash__tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
  }
  .dash__tile {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 0.9rem;
    border-radius: var(--radius);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }
  .dash__tile-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .dash__tile-icon--ok {
    background: rgba(63, 230, 140, 0.12);
    color: var(--color-mint);
  }
  .dash__tile-value {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .dash__tile-label {
    display: block;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .dash__bar-fill {
      transform: scaleY(1);
      animation: none;
    }
    .dash__live span {
      animation: none;
    }
  }
</style>
