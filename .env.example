# ── DevoriaTech — variables d'environnement ──
# Copiez ce fichier en `.env` et renseignez les valeurs réelles.
# Ces variables sont préfixées PUBLIC_ car utilisées côté client (build statique).

# Numéro WhatsApp au format international, sans + ni espaces
# Ex : 212612345678 (Maroc) ou 2250712345678 (Côte d'Ivoire)
PUBLIC_WHATSAPP_NUMBER=+212624291947

# ID Formspree (la partie après /f/ dans l'URL du formulaire)
# Créez un formulaire sur https://formspree.io puis collez l'ID ici. Ex : xldbzkqw
PUBLIC_FORMSPREE_ID=
